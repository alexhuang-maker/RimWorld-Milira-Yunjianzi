          <li>Scratch</li>
        </capacities>
        <power>11</power>
        <cooldownTime>1.5</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>EMP</def>
            <amount>6</amount>
          </li>
        </extraMeleeDamages>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>獠牙</label>
        <labelNoLocation>撕咬</labelNoLocation>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>16</power>
        <cooldownTime>2</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>EMP</def>
            <amount>6</amount>
          </li>
        </extraMeleeDamages>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>头槌</label>
        <capacities>
          <li>Blunt</li>
