        <power>11</power>
        <cooldownTime>1.5</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>EMP</def>
            <amount>6</amount>
          </li>
        </extraMeleeDamages>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>右爪</label>
        <labelNoLocation>雷爪</labelNoLocation>
