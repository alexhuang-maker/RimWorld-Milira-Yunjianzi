  <ThingDef ParentName="BuildingBase" Name="YJZ_ArrayCoreBase" Abstract="True">
    <label>琉璃阵眼</label>
    <description>依前代阵图炼成的琉璃枢珠。布阵之时，周围灵机皆由此回转，阵纹也随之相连。

有形之枢承无形之阵，故亦可循迹而破；珠毁，则诸纹俱散。</description>
    <thingClass>Yunjianzi.ThingYunjianziArrayCore</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <destroyable>true</destroyable>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <rotatable>false</rotatable>
    <statBases>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <graphicData>
      <texPath>Yunjianzi/Array/ArrayCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
      <color>(255,255,255)</color>
    </graphicData>
  </ThingDef>

