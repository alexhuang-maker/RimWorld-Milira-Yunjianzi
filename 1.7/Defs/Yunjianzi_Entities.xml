<Defs>
  <PawnRenderTreeDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>YJZ_EntityRenderTree</defName>
    <root Class="PawnRenderNodeProperties_Parent">
      <tagDef>Root</tagDef>
      <children>
        <li>
          <tagDef>Body</tagDef>
          <nodeClass>PawnRenderNode_AnimalPart</nodeClass>
          <workerClass>Yunjianzi.PawnRenderNodeWorker_YunjianziEntity</workerClass>
          <useRottenColor>false</useRottenColor>
        </li>
      </children>
    </root>
  </PawnRenderTreeDef>
  <ThinkTreeDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>YJZ_EntityThink</defName>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_Subtree">
          <treeDef>Despawned</treeDef>
        </li>
        <li Class="ThinkNode_Subtree">
          <treeDef>Downed</treeDef>
        </li>
        <li Class="Yunjianzi.JobGiver_YunjianziMobileMortar" />
        <li Class="ThinkNode_Subtree">
          <treeDef>LordDuty</treeDef>
        </li>
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
        </li>
        <li Class="JobGiver_WanderHerd" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
