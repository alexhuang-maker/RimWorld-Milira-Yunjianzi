<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Route Shenji beams to this mod's cyan-white motes. The shared HAVOC
       mote remains untouched; Shenji damage and chaining are unchanged. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Milira Faction: Milira Imperium</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="YJZ_Projectile_ShenjiLaser"]/projectile</xpath>
          <value><beamMoteDef>YJZ_Mote_ShenjiBeam</beamMoteDef></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="YJZ_Projectile_ShenjiChainLaser"]/projectile</xpath>
          <value><beamMoteDef>YJZ_Mote_ShenjiChainBeam</beamMoteDef></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
