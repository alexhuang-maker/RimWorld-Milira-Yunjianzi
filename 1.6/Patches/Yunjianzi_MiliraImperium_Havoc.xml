<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- When Milira Imperium is present, reuse its HAVOC beam shader/mote while
       keeping Shenji damage, chaining and weapon ownership inside this mod. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Milira Faction: Milira Imperium</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="YJZ_Projectile_ShenjiLaser"]/projectile</xpath>
          <value><beamMoteDef>MI_Mote_LaserPulse_HAVOC</beamMoteDef></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="YJZ_Projectile_ShenjiChainLaser"]/projectile</xpath>
          <value><beamMoteDef>MI_Mote_LaserPulse_HAVOC</beamMoteDef></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
