    <operations>
      <li Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="YJZ_UpgradeCore_Lingwei"]/recipeUsers</xpath>
        <value><recipeUsers><li>YJZ_Building_TrueJadeForge</li></recipeUsers></value>
      </li>
