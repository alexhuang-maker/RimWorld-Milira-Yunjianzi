<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>YJZ_Building_TalismanTable</defName>
    <label>云间画符台</label>
    <description>以白玉、日棱晶与米莉拉精密构件制成的画符台。云间子参悟某种符咒后，对应绘制配方才会显现。</description>
    <thingClass>Building_WorkTable</thingClass>
    <size>(3,2)</size>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Yunjianzi/Building/TalismanTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MaxHitPoints>420</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Mass>80</Mass>
      <Beauty>24</Beauty>
      <Flammability>0.18</Flammability>
      <WorkTableWorkSpeedFactor>1</WorkTableWorkSpeedFactor>
      <WorkTableEfficiencyFactor>1</WorkTableEfficiencyFactor>
    </statBases>
    <costList>
      <WoodLog>80</WoodLog>
      <Jade>30</Jade>
      <Milira_SolarCrystal>8</Milira_SolarCrystal>
      <Milira_SunPlateSteel>20</Milira_SunPlateSteel>
    </costList>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <designationCategory>Ideology</designationCategory>
    <uiOrder>3950</uiOrder>
    <passability>PassThroughOnly</passability>
    <pathCost>35</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <!-- 纸张位于台面南侧；操作员应站在纸前，而不是绕到背后的玉珠旁。 -->
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <inspectorTabs><li>ITab_Bills</li></inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
      <ai_chillDestination>false</ai_chillDestination>
      <buildingTags><li>Production</li></buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_ReportWorkSpeed">
        <workSpeedStat>WorkTableWorkSpeedFactor</workSpeedStat>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3.2</glowRadius>
        <glowColor>(120,235,245,0)</glowColor>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ReportWorkSpeedPenalties</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef Name="YJZ_TalismanBase" ParentName="ResourceBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <description>以灵力绘成、可供云间子佩用的阳符。</description>
    <stackLimit>10</stackLimit>
    <tradeability>All</tradeability>
    <thingCategories><li>Manufactured</li></thingCategories>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(0.72,0.72)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.05</Mass>
      <Flammability>0.35</Flammability>
    </statBases>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziTalisman" />
    </comps>
  </ThingDef>

