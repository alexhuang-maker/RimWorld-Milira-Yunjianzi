<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="StorageShelfBase">
    <defName>YJZ_TreasureCasket</defName>
    <label>建木镇宝匣</label>
    <description>“建木在都广，众帝所自上下。”——《淮南子·地形训》

道书《洞天篇》以建木贯通天地之说画成镇宝匣图。上一代未得神树，只以辉钢塑枝、白玉作根，让九宫灵路折叠树下方寸；现任云间子循图再造，使一座殖民地的家当各安其位。

效果：能够在折叠空间中收纳海量普通物品，并使其中物品免于腐坏。无法收纳建筑、植物、石块、大型尸体与废料包。</description>
    <thingClass>Yunjianzi.Building_TreasureCasket</thingClass>
    <designationCategory>YJZ_QinglingJade</designationCategory>
    <graphicData>
      <texPath>Yunjianzi/Buildings/Storage/TreasureCasket</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <!-- The physical footprint remains 3x3.  The rebuilt Jianmu uses a
           slightly larger draw square so the authored casket fills its
           footprint while the cloud canopy can overhang it.  The scaled Z
           offset keeps the casket, rather than the full tall sprite, centered
           over the selected cells. -->
      <drawSize>(5.75,5.75)</drawSize>
      <drawOffset>(0,0,2.00)</drawOffset>
    </graphicData>
    <size>(3,3)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <!-- Graphic_Single still receives the thing rotation. The authored asset
         is upright at North; forcing South was what inverted it in game. -->
    <defaultPlacingRot>North</defaultPlacingRot>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>80</pathCost>
    <fillPercent>0.72</fillPercent>
    <stuffCategories Inherit="False" />
    <costList>
      <Milira_SplendidSteel>300</Milira_SplendidSteel>
    </costList>
    <statBases>
      <MaxHitPoints>2500</MaxHitPoints>
      <Mass>120</Mass>
      <WorkToBuild>9000</WorkToBuild>
      <Beauty>140</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <minifiedDef>MinifiedThing</minifiedDef>
    <building>
      <storageGroupTag>YJZ_TreasureCasket</storageGroupTag>
      <!-- 112 stacks per cell across the 3x3 footprint gives 1008 stack
           positions. Stack contents and item mass do not impose another cap. -->
      <maxItemsInCell>112</maxItemsInCell>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <paintable>false</paintable>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <uiIconScale>0.68</uiIconScale>
    <uiOrder>3976</uiOrder>
  </ThingDef>
</Defs>
