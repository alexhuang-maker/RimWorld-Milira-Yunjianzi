<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="YJZ_MeditationBuildingBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <tickerType>Never</tickerType>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0.12</fillPercent>
    <rotatable>false</rotatable>
    <designationCategory>YJZ_QinglingJade</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <building>
      <isEdifice>false</isEdifice>
      <ai_chillDestination>true</ai_chillDestination>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="YJZ_MeditationBuildingBase">
    <defName>YJZ_Building_MeditationCushion</defName>
    <label>云纹蒲团</label>
    <description>“致虚极，守静笃。”——《道德经》

道书《坐忘篇》开篇只绘着一只寻常蒲团。它没有封存灵药，只让双膝有处安放；上一代云间子写道，大道若真在远方，也须从坐稳眼前这一刻开始。

效果：云间子可在此打坐并快速恢复灵力，是最基础的修行座位。</description>
    <stuffCategories><li>Fabric</li></stuffCategories>
    <costStuffCount>45</costStuffCount>
    <graphicData>
      <texPath>Yunjianzi/Buildings/Meditation/MeditationCushion</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconScale>0.9</uiIconScale>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>2</Mass>
      <Beauty>6</Beauty>
      <Flammability>0.7</Flammability>
    </statBases>
    <constructionSkillPrerequisite>2</constructionSkillPrerequisite>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziMeditationSeat">
        <baseRecoveryFactor>2</baseRecoveryFactor>
        <breakthroughPower>0</breakthroughPower>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="YJZ_MeditationBuildingBase">
    <defName>YJZ_Building_WhiteJadePlatform</defName>
    <label>白玉修行台</label>
    <description>“三十辐共一毂，当其无，有车之用。”——《道德经》

道书《坐忘篇》的九宫台图直到后继者根基稳固才会显现。台上最重要的并非翡翠、辉钢或日棱晶，而是中央空位；修炼者坐入其中，便以自身作阵眼。

效果：云间子可在此高效恢复灵力并稳步修行，也可用它举行高境界突破；同时能够照明并显著美化道场。</description>
    <size>(3,3)</size>
    <graphicData>
      <texPath>Yunjianzi/Buildings/Meditation/WhiteJadePlatform</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!-- The platform is effectively opaque; a transparent render queue made
           its full 2.7x2.7 quad draw over pawn apparel in the center opening. -->
      <shaderType>Cutout</shaderType>
      <drawSize>(2.7,2.7)</drawSize>
    </graphicData>
    <uiIconScale>0.65</uiIconScale>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <WorkToBuild>16000</WorkToBuild>
      <Mass>120</Mass>
      <Beauty>120</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Jade>200</Jade>
      <Milira_SplendidSteel>300</Milira_SplendidSteel>
      <Milira_SolarCrystal>80</Milira_SolarCrystal>
    </costList>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziMeditationSeat">
        <baseRecoveryFactor>3</baseRecoveryFactor>
        <breakthroughPower>0.5</breakthroughPower>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(255,255,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
</Defs>
