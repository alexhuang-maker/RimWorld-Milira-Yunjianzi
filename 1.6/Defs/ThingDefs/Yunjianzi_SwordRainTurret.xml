<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseBullet">
    <defName>YJZ_Projectile_SwordRainCasket</defName>
    <label>养剑灵光</label>
    <thingClass>Yunjianzi.ProjectileYunjianziSwordRainShell</thingClass>
    <graphicData>
      <texPath>Yunjianzi/Weapons/SwordShadow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>1.35</drawSize>
    </graphicData>
    <projectile>
      <flyOverhead>true</flyOverhead>
      <damageDef>Cut</damageDef>
      <!-- Match one complete Milira heavy-rocket salvo (8 x 28 = 224).
           Runtime resolves it as 56 + 56 + 112. -->
      <damageAmountBase>224</damageAmountBase>
      <armorPenetrationBase>0.45</armorPenetrationBase>
      <stoppingPower>2</stoppingPower>
      <speed>36</speed>
      <arcHeightFactor>14</arcHeightFactor>
      <shadowSize>1.1</shadowSize>
    </projectile>
  </ThingDef>

  <ThingDef>
    <defName>YJZ_Thing_CrossSwordStrike</defName>
    <label>交错剑意</label>
    <thingClass>Yunjianzi.ThingYunjianziCrossSwordStrike</thingClass>
    <category>Item</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <altitudeLayer>MoteOverhead</altitudeLayer>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>YJZ_TurretGun_SwordRain</defName>
    <label>云间养剑灵枢</label>
    <description>养剑台以池中灵剑投射剑意的内在灵枢。</description>
    <graphicData>
      <texPath>Yunjianzi/Buildings/Security/Transparent</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyLong>0.66</AccuracyLong>
      <RangedWeapon_Cooldown>18</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>52</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>YJZ_Projectile_SwordRainCasket</defaultProjectile>
        <warmupTime>2.4</warmupTime>
        <minRange>4.9</minRange>
        <range>35.9</range>
        <requireLineOfSight>false</requireLineOfSight>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <burstShotCount>1</burstShotCount>
        <soundCast>Mortar_LaunchA</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>2</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetSelf>true</canTargetSelf>
          <canTargetPawns>true</canTargetPawns>
          <canTargetFires>true</canTargetFires>
          <canTargetBuildings>true</canTargetBuildings>
          <canTargetItems>true</canTargetItems>
          <canTargetAnimals>true</canTargetAnimals>
          <canTargetHumans>true</canTargetHumans>
          <canTargetMechs>true</canTargetMechs>
          <canTargetPlants>true</canTargetPlants>
          <canTargetCorpses>true</canTargetCorpses>
          <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
        </targetParams>
        <ai_RangedAlawaysShootGroundBelowTarget>true</ai_RangedAlawaysShootGroundBelowTarget>
        <ai_AvoidFriendlyFireRadius>6</ai_AvoidFriendlyFireRadius>
        <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>YJZ_Building_SwordRainTurret</defName>
    <label>云间养剑台</label>
    <description>以真玉钢砌成的灵池养剑台。四道锁链与结界将一柄剑束在池心，剑尖向下，随灵潮沉浮。轰击时池中剑光大盛，在落点先后投下两柄交错灵剑：一剑自左上劈向右下，一剑自右上劈向左下，以交叉剑气爆发造成切割杀伤。</description>
    <thingClass>Yunjianzi.Building_YunjianziSwordRainTurret</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Yunjianzi/Buildings/Security/SwordNurturingPool_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.15,2.15)</drawSize>
      <drawOffset>(0,0,-0.08)</drawOffset>
      <damageData>
        <rect>(0.25,0.25,1.5,1.5)</rect>
      </damageData>
      <shadowData>
        <volume>(1.65,0.32,1.55)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>Yunjianzi/Buildings/Security/SwordNurturingPool_Base</uiIconPath>
    <uiIconScale>0.9</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>650</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>24000</WorkToBuild>
      <Mass>80</Mass>
      <Beauty>8</Beauty>
      <ShootingAccuracyTurret>1.00</ShootingAccuracyTurret>
      <Ancot_TurretRotateSpeed>35</Ancot_TurretRotateSpeed>
      <Ancot_TurretShootAngleLimit>30</Ancot_TurretShootAngleLimit>
    </statBases>
    <costList>
      <YJZ_TrueJadeSteel>240</YJZ_TrueJadeSteel>
      <Milira_SunPlateSteel>100</Milira_SunPlateSteel>
      <Milira_SolarCrystal>30</Milira_SolarCrystal>
      <ComponentSpacer>5</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>Milira_HeavyRocketLauncher</li>
    </researchPrerequisites>
    <damageMultipliers>
      <li><damageDef>Flame</damageDef><multiplier>0</multiplier></li>
      <li><damageDef>Milira_PlasmaBomb</damageDef><multiplier>0.5</multiplier></li>
      <li><damageDef>Bomb</damageDef><multiplier>0.5</multiplier></li>
    </damageMultipliers>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs><li>Stun</li><li>EMP</li></affectedDamageDefs>
        <adaptableDamageDefs><li>EMP</li></adaptableDamageDefs>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>YJZ_QinglingJade</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <building>
      <combatPower>260</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>YJZ_TurretGun_SwordRain</turretGunDef>
      <turretBurstCooldownTime>18</turretBurstCooldownTime>
      <turretTopOffset>(0,0.05)</turretTopOffset>
      <turretTopDrawSize>0.01</turretTopDrawSize>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>Yunjianzi.PlaceWorker_YunjianziTurretRadius</li>
    </placeWorkers>
  </ThingDef>
</Defs>
