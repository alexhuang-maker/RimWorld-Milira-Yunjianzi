<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="Milira_MilianBase_Pawn">
    <defName>YJZ_Shenji_Race</defName>
    <label>神机米莉安</label>
    <description>“金石能载道，光电亦可书符。”

道书《神机篇》记着上一代云间子与一位米莉安同行的旧事，也留下重塑其身的完整器图。现任云间子依图以米莉拉技术塑身、以符法贯通能源与灵识，却仍把选择与成长留给被唤醒者自己。

效果：云间子的专属火力支援型米莉安，不占用机械带宽，拥有自循环能源；武器与固有装甲会随云间子的境界成长。</description>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed>
      <MarketValue>2200</MarketValue>
      <BandwidthCost MayRequire="Ludeon.Rimworld.Biotech">0</BandwidthCost>
      <MechEnergyLossPerHP MayRequire="Ludeon.Rimworld.Biotech">0</MechEnergyLossPerHP>
    </statBases>
    <race>
      <baseHealthScale>1.35</baseHealthScale>
    </race>
    <comps Inherit="False">
      <!-- 神机使用米莉拉自己的双层发型渲染器。列表故意只留一项：
           N1-3 是齐颈短发（北向的小辫属于同一套背发），因此生成与换向都不会随机。 -->
      <li Class="Milira.CompProperties_MilianHairSwitch">
        <gizmoIconPath>Milira/UI/HairChange</gizmoIconPath>
        <frontHairPaths>
          <!-- The visor is baked into this dedicated front-hair layer.  Milira's
               hair renderer follows head animation; Overhead apparel does not. -->
          <li>Yunjianzi/Pawn/Shenji/ShenjiHairFront</li>
        </frontHairPaths>
        <behindHairPaths>
          <li>Yunjianzi/Pawn/Shenji/ShenjiHairBack</li>
        </behindHairPaths>
      </li>
      <li Class="CompProperties_CanBeDormant" />
      <li Class="CompProperties_WakeUpDormant"><wakeUpOnDamage>true</wakeUpOnDamage><wakeUpCheckRadius>30</wakeUpCheckRadius><wakeUpSound>MechanoidsWakeUp</wakeUpSound></li>
      <!-- 神机带宽费用为 0，但征召、控制组与米莉安工作管理依赖原生监督关系。 -->
      <li MayRequire="Ludeon.Rimworld.Biotech" Class="CompProperties_OverseerSubject">
        <needsOverseerEffect>MechUncontrolled</needsOverseerEffect>
        <delayUntilFeralCheck>60000</delayUntilFeralCheck>
        <feralMtbDays>10</feralMtbDays>
        <feralCascadeRadialDistance>25</feralCascadeRadialDistance>
      </li>
      <li MayRequire="Ludeon.Rimworld.Biotech" Class="CompProperties_MechRepairable" />
      <li Class="Milira.CompProperties_MilianApparelRender" />
      <li Class="Milira.CompProperties_GainHediffSpawn">
        <hediffDef>Milian_ClassHediff_Pawn</hediffDef>
      </li>
      <li><compClass>Milira.CompStripMilian</compClass></li>
      <li Class="AncotLibrary.CompProperties_MechAutoFight"><hediffDef>Milira_MilianAutoFightHint</hediffDef><requireResearch>Milira_MilianTech_AutoFight</requireResearch></li>
      <li Class="Milira.CompProperties_EquipMilian"><useJob>Milira_EquipMilianPre</useJob><useDuration>0</useDuration><warmupMote>Mote_ResurrectAbility</warmupMote></li>
      <li Class="Milira.CompProperties_TargetEffect_EquipMilian" />
      <li Class="Milira.CompProperties_TargetableWeapon"><compClass>Milira.CompTargetableWeapon</compClass><ignoreQuestLodgerPawns>true</ignoreQuestLodgerPawns></li>
      <li Class="Yunjianzi.CompProperties_YunjianziShenji" />
    </comps>
    <uiIconPath>Milian/Mechanoid_uiIcon/PawnI</uiIconPath>
  </ThingDef>

  <PawnKindDef ParentName="BaseMilianKind_Mechanoid">
    <defName>YJZ_Shenji</defName>
    <label>神机米莉安</label>
    <race>YJZ_Shenji_Race</race>
    <combatPower>220</combatPower>
    <forceNormalGearQuality>true</forceNormalGearQuality>
    <weaponMoney>0</weaponMoney>
    <apparelMoney>0</apparelMoney>
    <techHediffsMoney>0</techHediffsMoney>
    <!-- The armor art is a complete body shell.  A dedicated transparent base
         prevents Milian's nude body graphic from protruding around its hips,
         chest and legs while preserving the native Milian render tree. -->
    <lifeStages Inherit="False">
      <li>
        <bodyGraphicData>
          <texPath>Yunjianzi/Pawn/Shenji/ShenjiTransparentBody</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <ThingDef ParentName="Gun_AssaultRifle">
    <defName>YJZ_Weapon_Shenji_Assault</defName>
    <label>神机炮·初式</label>
    <description>“九层之台，起于累土。”——《道德经》

道书第一幅炮图仍保留制式突击步枪结构，只在枪机内多出一圈与修炼者灵脉同频的青色符路。它不以奇迹取胜，却是此后一切火力变化的可靠根基。

效果：练气阶段使用的可靠点射武器，性能接近制式突击步枪；会随境界自动替换。</description>
    <graphicData>
      <texPath>Yunjianzi/Weapons/ShenjiCannon_Assault</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <!-- 枪身横向拉长，但不同比例放大厚度，保持普通人可肩射的步枪轮廓。 -->
      <drawSize>(1.42,1.10)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="Gun_Minigun">
    <defName>YJZ_Weapon_Shenji_Gatling</defName>
    <label>神机炮·连星</label>
    <description>“枢始得其环中，以应无穷。”——《庄子》

道书第二幅炮图须待筑基方能展开：单一枪管围绕灵能中枢化作连星炮机。每一发都借下一发校正自身，密集弹流如群星循轨。

效果：筑基阶段使用的速射武器，擅长以密集弹流压制敌人；会随境界自动替换。</description>
    <graphicData>
      <texPath>Yunjianzi/Weapons/ShenjiCannon_Gatling</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1.52,1.12)</drawSize>
    </graphicData>
  </ThingDef>

  <!-- 紫府后的主射线与金丹折射射线共享米莉拉帝国的淡蓝光束材质。
       主射线基础伤害为10，折射射线为3，严格等于30%。 -->
  <ThingDef ParentName="MiliraBullet_Ray">
    <defName>YJZ_Projectile_ShenjiLaser</defName>
    <label>神机辉光</label>
    <thingClass>Yunjianzi.Projectile_YunjianziShenjiLaser</thingClass>
    <projectile>
      <damageAmountBase>10</damageAmountBase>
      <armorPenetrationBase>0.45</armorPenetrationBase>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="MiliraBullet_Ray">
    <defName>YJZ_Projectile_ShenjiChainLaser</defName>
    <label>神机折射辉光</label>
    <projectile>
      <damageAmountBase>3</damageAmountBase>
      <armorPenetrationBase>0.30</armorPenetrationBase>
      <beamStartOffset>0</beamStartOffset>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="Gun_AssaultRifle" Name="YJZ_Weapon_Shenji_Gauss_Base">
    <defName>YJZ_Weapon_Shenji_Gauss</defName>
    <label>神机炮·辉光</label>
    <description>“电以照幽，雷以震妄。”

道书第三幅炮图须以紫府神识读取，使神机炮舍弃实体弹丸，将日棱晶约束的能量压成淡蓝辉光。这是上一代云间子对古人所谓“神光”的工程学解答。

效果：紫府阶段使用的远程脉冲激光炮，能够快速连射并有效穿透护甲。</description>
    <graphicData>
      <texPath>Yunjianzi/Weapons/ShenjiCannon_Gauss</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1.64,1.15)</drawSize>
    </graphicData>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>YJZ_Projectile_ShenjiLaser</defaultProjectile><warmupTime>1.0</warmupTime>
        <range>35.9</range><burstShotCount>6</burstShotCount><ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <soundCast>Shot_AssaultRifle</soundCast><muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="YJZ_Weapon_Shenji_Gauss_Base">
    <defName>YJZ_Weapon_Shenji_Legendary</defName>
    <label>神机炮·传说</label>
    <description>“大方无隅，大器晚成。”——《道德经》

道书最后一幅炮图只写“以金丹为炉，以神机为器”。至此炮身所有折叠结构完全展开，主辉光贯穿目标，余能由阵列重新导向，在敌阵之间递次折射。

效果：金丹及更高境界使用的最终辉光炮，射程远、连射迅疾，并能使光束向其他敌人折射。</description>
    <graphicData>
      <texPath>Yunjianzi/Weapons/ShenjiCannon_Legendary</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(1.72,1.18)</drawSize>
    </graphicData>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>YJZ_Projectile_ShenjiLaser</defaultProjectile><warmupTime>0.65</warmupTime>
        <range>39.9</range><burstShotCount>9</burstShotCount><ticksBetweenBurstShots>3</ticksBetweenBurstShots>
        <soundCast>Shot_AssaultRifle</soundCast><muzzleFlashScale>11</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>
</Defs>
