<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="YJZ_Shenji_RaceBase" ParentName="Milira_MilianBase_Pawn" Abstract="True">
    <label>青羽机侍</label>
    <description>“金石能载道，光电亦可书符。”

道书《神机篇》记着上一代云间子与一位米莉安同行的旧事，也留下重塑其身的完整器图。现任云间子依图以米莉拉技术塑身、以符法贯通能源与灵识，却仍把选择与成长留给被唤醒者自己。

效果：云间子的专属火力支援型米莉安，不占用机械带宽，拥有自循环能源。机体型号由投入米莉安培育器的神机核心决定；装甲与武器需要另行制造和穿戴。</description>
    <statBases><BandwidthCost MayRequire="Ludeon.Rimworld.Biotech">0</BandwidthCost><MechEnergyLossPerHP MayRequire="Ludeon.Rimworld.Biotech">0</MechEnergyLossPerHP></statBases>
    <comps Inherit="False">
      <!-- 神机使用米莉拉自己的双层发型渲染器。列表故意只留一项：
           N1-3 是齐颈短发（北向的小辫属于同一套背发），因此生成与换向都不会随机。 -->
      <li Class="Milira.CompProperties_MilianHairSwitch">
        <gizmoIconPath>Milira/UI/HairChange</gizmoIconPath>
        <frontHairPaths>
          <!-- Hair only. The tactical visor follows Milira Guard's native
               Milian_Goggle / Overhead apparel pipeline and is never baked here. -->
          <li>Yunjianzi/Pawn/Shenji/ShenjiHairFront</li>
        </frontHairPaths>
        <behindHairPaths>
          <li>Yunjianzi/Pawn/Shenji/ShenjiHairBack</li>
        </behindHairPaths>
      </li>
      <li Class="CompProperties_CanBeDormant" />
      <li Class="CompProperties_WakeUpDormant"><wakeUpOnDamage>true</wakeUpOnDamage><wakeUpCheckRadius>30</wakeUpCheckRadius><wakeUpSound>MechanoidsWakeUp</wakeUpSound></li>
      <!-- 神机带宽费用为 0，但征召、控制组与米莉安工作管理依赖原生监督关系。 -->
      <li MayRequire="Ludeon.Rimworld.Biotech" Class="CompProperties_OverseerSubject">
        <needsOverseerEffect>MechUncontrolled</needsOverseerEffect>
        <delayUntilFeralCheck>60000</delayUntilFeralCheck>
        <feralMtbDays>10</feralMtbDays>
        <feralCascadeRadialDistance>25</feralCascadeRadialDistance>
      </li>
      <li MayRequire="Ludeon.Rimworld.Biotech" Class="CompProperties_MechRepairable" />
      <li Class="Milira.CompProperties_MilianApparelRender" />
      <li Class="Milira.CompProperties_GainHediffSpawn">
        <hediffDef>Milian_ClassHediff_Pawn</hediffDef>
      </li>
      <li><compClass>Milira.CompStripMilian</compClass></li>
      <li Class="AncotLibrary.CompProperties_MechAutoFight"><hediffDef>Milira_MilianAutoFightHint</hediffDef><requireResearch>Milira_MilianTech_AutoFight</requireResearch></li>
      <li Class="Milira.CompProperties_EquipMilian"><useJob>Milira_EquipMilianPre</useJob><useDuration>0</useDuration><warmupMote>Mote_ResurrectAbility</warmupMote></li>
      <li Class="Milira.CompProperties_TargetEffect_EquipMilian" />
      <li Class="Milira.CompProperties_TargetableWeapon"><compClass>Milira.CompTargetableWeapon</compClass><ignoreQuestLodgerPawns>true</ignoreQuestLodgerPawns></li>
      <li Class="Yunjianzi.CompProperties_YunjianziShenji" />
    </comps>
    <uiIconPath>Milian/Mechanoid_uiIcon/PawnI</uiIconPath>
  </ThingDef>

  <!-- 三种机体是固定型号，不再随主人境界自动变形。 -->
  <ThingDef ParentName="YJZ_Shenji_RaceBase">
    <defName>YJZ_Shenji_Race</defName><label>青羽机侍</label>
    <statBases><MoveSpeed>4.6</MoveSpeed><WorkSpeedGlobal>0.80</WorkSpeedGlobal><MarketValue>2200</MarketValue></statBases>
    <race><baseHealthScale>1.35</baseHealthScale><mechFixedSkillLevel>10</mechFixedSkillLevel></race>
  </ThingDef>
  <ThingDef ParentName="YJZ_Shenji_RaceBase">
    <defName>YJZ_Shenji_Race_Lingwei</defName><label>玄翎灵卫</label>
    <statBases><MoveSpeed>4.9</MoveSpeed><WorkSpeedGlobal>1.00</WorkSpeedGlobal><MarketValue>3400</MarketValue></statBases>
    <race><baseHealthScale>1.70</baseHealthScale><mechFixedSkillLevel>12</mechFixedSkillLevel></race>
  </ThingDef>
  <ThingDef ParentName="YJZ_Shenji_RaceBase">
    <defName>YJZ_Shenji_Race_Tianjiang</defName><label>九霄天将</label>
    <statBases><MoveSpeed>5.25</MoveSpeed><WorkSpeedGlobal>1.20</WorkSpeedGlobal><MarketValue>5200</MarketValue></statBases>
    <race>
      <baseHealthScale>2.15</baseHealthScale>
      <mechFixedSkillLevel>14</mechFixedSkillLevel>
      <!-- 普通米莉安底板没有知识工作；仅完成体能够进行研究。 -->
      <mechEnabledWorkTypes><li>Research</li></mechEnabledWorkTypes>
    </race>
  </ThingDef>

  <PawnKindDef Name="YJZ_ShenjiKindBase" ParentName="BaseMilianKind_Mechanoid" Abstract="True">
    <race>YJZ_Shenji_Race</race>
    <combatPower>220</combatPower>
    <weaponMoney>0</weaponMoney>
    <apparelMoney>0</apparelMoney>
    <techHediffsMoney>0</techHediffsMoney>
  </PawnKindDef>

  <PawnKindDef ParentName="YJZ_ShenjiKindBase">
    <defName>YJZ_Shenji</defName>
    <label>青羽机侍</label>
    <!-- Intrinsic armor is a true Milian apparel overlay. Keep the native
         Milian body underneath so legs and joints remain visible. -->
  </PawnKindDef>

  <PawnKindDef ParentName="YJZ_ShenjiKindBase">
    <defName>YJZ_Shenji_Lingwei</defName>
    <label>玄翎灵卫</label>
    <race>YJZ_Shenji_Race_Lingwei</race>
    <combatPower>340</combatPower>
  </PawnKindDef>

  <PawnKindDef ParentName="YJZ_ShenjiKindBase">
    <defName>YJZ_Shenji_Tianjiang</defName>
    <label>九霄天将</label>
    <race>YJZ_Shenji_Race_Tianjiang</race>
    <combatPower>520</combatPower>
    <modExtensions>
      <li Class="MilianModification.MilianComponentExtension">
        <componentScheme>
          <li>
            <selectWeight>1</selectWeight>
            <availableComponents_Head>
              <li>YJZ_MilianFitting_CloudCommandChip</li>
            </availableComponents_Head>
          </li>
        </componentScheme>
      </li>
    </modExtensions>
