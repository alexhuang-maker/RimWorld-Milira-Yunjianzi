      <texPath>Yunjianzi/Items/BoundImmortalScroll</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(0.82,0.82)</drawSize>
    </graphicData>
    <uiIconScale>0.88</uiIconScale>
    <statBases>
      <MarketValue>0</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziBoundScroll" />
    </comps>
  </ThingDef>
</Defs>
