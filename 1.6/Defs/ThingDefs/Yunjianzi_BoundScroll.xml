<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>YJZ_Item_BoundImmortalScroll</defName>
    <label>前代云间子手记</label>
    <description>上一代云间子留下的修行笔记。书页间记着沿途的星图、异常的征兆，以及运气、养息和练剑的方法。几处墨迹已经洇开，页边仍留着后来补上的纠错。

开篇写得尤其细。作者似乎很清楚初学者会在哪些地方犯错，连气息走岔时该如何停下，都另作了标记。对刚踏上修行之路的云间子而言，这些经验能省去许多摸索。</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <stackLimit>1</stackLimit>
    <thingCategories>
      <li>Books</li>
    </thingCategories>
    <graphicData>
      <texPath>Yunjianzi/Items/BoundImmortalScroll</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(0.82,0.82)</drawSize>
    </graphicData>
    <uiIconScale>0.88</uiIconScale>
    <statBases>
      <MarketValue>0</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziBoundScroll" />
    </comps>
  </ThingDef>
</Defs>
