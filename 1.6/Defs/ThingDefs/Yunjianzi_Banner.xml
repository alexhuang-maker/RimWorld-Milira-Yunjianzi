<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- This is ordinary player furniture, not a mech-cluster member.  Using
       MechBuildingBase silently inherited threat/signalling/cluster tags. -->
  <ThingDef ParentName="BuildingBase">
    <defName>YJZ_Building_YunjianziBanner</defName>
    <label>云间之影</label>
    <description>“云无心以出岫。”——陶渊明《归去来兮辞》

道书夹页绘有一面无风自展的旧旌，旗心正是诛邪、云纹与残缺玉环。现任云间子以白玉灵珠复现其影；它不宣示领地，只证明上一代曾在某个陌生世界停云，而这一代又在此续上道统。

效果：无需供能的云间子传承旗帜，能够照明并显著美化周围环境。</description>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <repairEffect>ConstructMetal</repairEffect>
    <stealable>true</stealable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <designationCategory>YJZ_QinglingJade</designationCategory>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Mass>2</Mass>
      <MarketValue>520</MarketValue>
      <Beauty>200</Beauty>
      <WorkToBuild>1600</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Milira_SplendidSteel>60</Milira_SplendidSteel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Milira_SolarCrystal>4</Milira_SolarCrystal>
    </costList>
    <graphicData>
      <texPath>Yunjianzi/Buildings/YunjianziBannerBase</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <drawOffset>(0,0,0.89)</drawOffset>
      <shadowData>
        <volume>(0.6,0.4,0.6)</volume>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <drawOffscreen>true</drawOffscreen>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <building>
      <minDistanceToSameTypeOfBuilding>5</minDistanceToSameTypeOfBuilding>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(255,255,255,0)</glowColor>
      </li>
      <li Class="AncotLibrary.CompProperties_AdditionalGraphic">
        <floatAmplitude>0.2</floatAmplitude>
        <floatSpeed>0.008</floatSpeed>
        <graphicData>
          <texPath>Yunjianzi/Buildings/YunjianziBannerProjection</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <shaderType>TransparentPostLight</shaderType>
          <drawSize>(2.5,10)</drawSize>
          <drawOffset>(0,0,4.2)</drawOffset>
        </graphicData>
        <altitudeLayer>Skyfaller</altitudeLayer>
      </li>
      <li Class="CompProperties_Facility">
        <maxSimultaneous>4</maxSimultaneous>
        <maxDistance>8</maxDistance>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
  </ThingDef>
</Defs>
