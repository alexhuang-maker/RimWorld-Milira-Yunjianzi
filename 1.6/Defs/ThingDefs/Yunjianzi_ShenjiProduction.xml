<Defs>
  <ThingDef Name="YJZ_ShenjiCoreBase" ParentName="ResourceBase" Abstract="True">
    <description>以米莉安许可芯片为骨架、以云间灵脉重写而成的神机核心。核心不会在培育中消耗其本质，拆解对应神机时可以完整回收。</description>
    <stackLimit>1</stackLimit><tradeability>None</tradeability><thingCategories><li>Manufactured</li></thingCategories>
  </ThingDef>
  <ThingDef ParentName="YJZ_ShenjiCoreBase"><defName>YJZ_ShenjiCore_Qingyu</defName><label>青羽神机核心</label><graphicData><texPath>Yunjianzi/Items/ShenjiCore_Qingyu</texPath><graphicClass>Graphic_Single</graphicClass></graphicData><statBases><MarketValue>1200</MarketValue><Mass>2</Mass></statBases></ThingDef>
  <ThingDef ParentName="YJZ_ShenjiCoreBase"><defName>YJZ_ShenjiCore_Lingwei</defName><label>玄翎神机核心</label><graphicData><texPath>Yunjianzi/Items/ShenjiCore_Lingwei</texPath><graphicClass>Graphic_Single</graphicClass></graphicData><statBases><MarketValue>2800</MarketValue><Mass>2</Mass></statBases></ThingDef>
  <ThingDef ParentName="YJZ_ShenjiCoreBase"><defName>YJZ_ShenjiCore_Tianjiang</defName><label>九霄神机核心</label><graphicData><texPath>Yunjianzi/Items/ShenjiCore_Tianjiang</texPath><graphicClass>Graphic_Single</graphicClass></graphicData><statBases><MarketValue>6000</MarketValue><Mass>2</Mass></statBases></ThingDef>

  <!-- 核心升级：旧核心本体作为唯一基底，确保数量守恒。 -->
  <RecipeDef><defName>YJZ_UpgradeCore_Lingwei</defName><label>升炼玄翎神机核心</label><description>以紫府神识重写青羽核心，使其能够承载玄翎灵卫机体。</description><jobString>正在升炼玄翎核心</jobString><workerClass>Yunjianzi.RecipeWorker_YunjianziShenji</workerClass><workAmount>6000</workAmount><workSkill>Crafting</workSkill><effectWorking>Smith</effectWorking><soundWorking>Recipe_Machining</soundWorking><recipeUsers><li>FabricationBench</li><li>Milira_UniversalBench</li></recipeUsers><ingredients><li><filter><thingDefs><li>YJZ_ShenjiCore_Qingyu</li></thingDefs></filter><count>1</count></li><li><filter><thingDefs><li>YJZ_TrueJadeSteel</li></thingDefs></filter><count>20</count></li><li><filter><thingDefs><li>Milira_SolarCrystal</li></thingDefs></filter><count>4</count></li><li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>2</count></li></ingredients><products><YJZ_ShenjiCore_Lingwei>1</YJZ_ShenjiCore_Lingwei></products></RecipeDef>
  <RecipeDef><defName>YJZ_UpgradeCore_Tianjiang</defName><label>升炼九霄神机核心</label><description>以金丹为炉，将玄翎核心炼成能够驾驭九霄天将机体的高阶灵核。</description><jobString>正在升炼九霄核心</jobString><workerClass>Yunjianzi.RecipeWorker_YunjianziShenji</workerClass><workAmount>12000</workAmount><workSkill>Crafting</workSkill><effectWorking>Smith</effectWorking><soundWorking>Recipe_Machining</soundWorking><recipeUsers><li>FabricationBench</li><li>Milira_UniversalBench</li></recipeUsers><ingredients><li><filter><thingDefs><li>YJZ_ShenjiCore_Lingwei</li></thingDefs></filter><count>1</count></li><li><filter><thingDefs><li>YJZ_TrueJadeSteel</li></thingDefs></filter><count>40</count></li><li><filter><thingDefs><li>Milira_SolarCrystal</li></thingDefs></filter><count>8</count></li><li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>4</count></li></ingredients><products><YJZ_ShenjiCore_Tianjiang>1</YJZ_ShenjiCore_Tianjiang></products></RecipeDef>

  <!-- 米莉安培育器配方；核心是数量为一的原料，所以原版拆解会完整返还。 -->
  <RecipeDef ParentName="Milian_GestatingRecipe"><defName>YJZ_Gestate_Qingyu</defName><label>培育青羽机侍</label><description>使用青羽核心培育一具基础神机米莉安。</description><workerClass>Yunjianzi.RecipeWorker_YunjianziShenji</workerClass><gestationCycles>1</gestationCycles><ingredients Inherit="False"><li><filter><thingDefs><li>Milira_FeatherThread</li></thingDefs></filter><count>80</count></li><li><filter><thingDefs><li>YJZ_ShenjiCore_Qingyu</li></thingDefs></filter><count>1</count></li><li><filter><thingDefs><li>Milira_SplendidSteel</li></thingDefs></filter><count>80</count></li><li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>4</count></li></ingredients><products><YJZ_Shenji_Race>1</YJZ_Shenji_Race></products><descriptionHyperlinks><ThingDef>YJZ_Shenji_Race</ThingDef></descriptionHyperlinks></RecipeDef>
