<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp">
    <defName>YJZ_Weapon_Zhuxie</defName>
    <label>诛邪</label>
    <description>“胜人者有力，自胜者强。”——《道德经》

诛邪的剑图藏在道书封底。上一代云间子留下的不是一柄已经无敌的神兵，而是一道未曾替继承者作答的剑胚：所谓诛邪，先诛世间之敌，还是先斩心中妄念？此后剑不更名，也不另铸，只随继承者一同成长。

效果：云间子的唯一仙剑，威力、穿透、剑影与附魔都会随修行境界成长。</description>
    <thingClass>ThingWithComps</thingClass>
    <rotatable>true</rotatable>
    <!-- Zhuxie is unique and summoned, never crafted or smelted. Clear the
         manufacturing fields inherited from BaseMeleeWeapon_Sharp. -->
    <recipeMaker Inherit="False" IsNull="True" />
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <techLevel>Ultra</techLevel>
    <weaponTags><li>YJZ_Zhuxie</li></weaponTags>
    <weaponClasses><li>MeleePiercer</li></weaponClasses>
    <graphicData>
      <texPath>Yunjianzi/Weapons/Zhuxie</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.35</drawSize>
      <color>(255,255,255)</color>
    </graphicData>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <soundInteract>Interact_MonoSword</soundInteract>
    <meleeHitSound>MeleeHit_MonoSword</meleeHitSound>
    <statBases>
      <MarketValue>3200</MarketValue>
      <Mass>1.5</Mass>
      <MaxHitPoints>500</MaxHitPoints>
    </statBases>
    <tools>
      <li>
        <label>诛邪剑刃</label>
        <capacities><li>Cut</li><li>Stab</li></capacities>
        <power>25</power>
        <cooldownTime>2</cooldownTime>
        <armorPenetration>0.9</armorPenetration>
        <chanceFactor>1</chanceFactor>
      </li>
    </tools>
  </ThingDef>
</Defs>
