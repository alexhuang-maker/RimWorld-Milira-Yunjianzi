  <PawnKindDef Name="YJZ_SkyWyvernKind_Base" ParentName="AnimalKindBase" Abstract="True">
    <label>云麒麟</label><combatPower>1600</combatPower><weaponMoney>0</weaponMoney><apparelMoney>0</apparelMoney><techHediffsMoney>0</techHediffsMoney>
    <lifeStages>
      <li><bodyGraphicData><texPath>Yunjianzi/Pawn/Shenji/ShenjiTransparentBody</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1</drawSize></bodyGraphicData></li>
    </lifeStages>
  </PawnKindDef>
  <PawnKindDef ParentName="YJZ_SkyWyvernKind_Base"><defName>YJZ_SkyWyvern_Purple</defName><label>云麒麟·紫府</label><race>YJZ_SkyWyvern_Race_Purple</race><combatPower>1800</combatPower></PawnKindDef>
  <PawnKindDef ParentName="YJZ_SkyWyvernKind_Base">
    <defName>YJZ_SkyWyvern_Golden</defName><label>云麒麟·金丹</label><race>YJZ_SkyWyvern_Race_Golden</race><combatPower>4500</combatPower>
    <abilities><li>YJZ_SkyWyvernBreath</li></abilities>
  </PawnKindDef>
  <PawnKindDef ParentName="YJZ_SkyWyvernKind_Base">
    <defName>YJZ_SkyWyvern_Spirit</defName><label>云麒麟·化神</label><race>YJZ_SkyWyvern_Race_Spirit</race><combatPower>12000</combatPower>
    <abilities><li>YJZ_SkyWyvernBreath</li></abilities>
  </PawnKindDef>

  <!-- Animal_PreMain is an official extension point in the vanilla Animal
       think tree. The job giver immediately returns null for every other
       animal, so this does not alter colony pets or released war animals. -->
  <ThinkTreeDef>
    <defName>YJZ_SkyWyvernRaidAssault</defName>
    <insertTag>Animal_PreMain</insertTag>
    <insertPriority>1000</insertPriority>
    <thinkRoot Class="Yunjianzi.JobGiver_YunjianziSkyWyvernRaidAssault">
      <targetAcquireRadius>999</targetAcquireRadius>
      <targetKeepRadius>999</targetKeepRadius>
      <chaseTarget>true</chaseTarget>
      <allowTurrets>true</allowTurrets>
      <ignoreNonCombatants>true</ignoreNonCombatants>
    </thinkRoot>
  </ThinkTreeDef>

  <AbilityDef>
    <defName>YJZ_SkyWyvernBreath</defName>
    <label>雷霆吐息</label>
    <description>吐出汇聚于灵角与经脉中的高密度雷霆，对目标区域造成雷电、EMP与麻痹。云麒麟在袭击中会自主选择密集敌群施放。</description>
    <iconPath>Yunjianzi/UI/Abilities/SummonSkyWyvern</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <aiCanUse>true</aiCanUse>
    <ai_IsOffensive>true</ai_IsOffensive>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <hostile>true</hostile>
    <statBases><Ability_EffectRadius>3.9</Ability_EffectRadius></statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15.9</range>
      <warmupTime>1.2</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetHumans>true</canTargetHumans>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Yunjianzi.CompProperties_AbilitySkyWyvernBreath" />
    </comps>
  </AbilityDef>

  <HediffDef>
    <defName>YJZ_SkyWyvernAcceleration</defName>
    <label>云麒麟瑞气</label>
    <description>云麒麟舒展的护佑瑞气，正在提升友军的移动与操作效率。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages><li><statOffsets><MoveSpeed>0.6</MoveSpeed></statOffsets><capMods><li><capacity>Manipulation</capacity><offset>0.08</offset></li></capMods></li></stages>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks><min>120</min><max>120</max></disappearsAfterTicks></li></comps>
  </HediffDef>
</Defs>
