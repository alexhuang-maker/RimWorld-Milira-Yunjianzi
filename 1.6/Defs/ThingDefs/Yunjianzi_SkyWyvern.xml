    <label>云麒麟·紫府</label>
    <statBases>
      <MoveSpeed>4.14</MoveSpeed><MaxHitPoints>6000</MaxHitPoints><MarketValue>24000</MarketValue>
    </statBases>
    <race><baseBodySize>4</baseBodySize><baseHealthScale>6</baseHealthScale></race>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziSkyWyvern">
        <stage>3</stage><groundTexPath>Yunjianzi/Pawn/SkyWyvern/UnifiedGround</groundTexPath><drawSize>2.8</drawSize>
      </li>
    </comps>
  </ThingDef>
