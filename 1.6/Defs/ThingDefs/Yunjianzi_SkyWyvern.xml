  <PawnKindDef Name="YJZ_SkyWyvernKind_Base" ParentName="AnimalKindBase" Abstract="True">
    <label>云麒麟</label><combatPower>1600</combatPower><weaponMoney>0</weaponMoney><apparelMoney>0</apparelMoney><techHediffsMoney>0</techHediffsMoney>
    <!-- Its legend may span millennia, but generated pawns must not roll a
         millennia-old biological age and receive vanilla geriatric diseases. -->
    <minGenerationAge>30</minGenerationAge>
    <maxGenerationAge>30</maxGenerationAge>
    <allowOldAgeInjuries>false</allowOldAgeInjuries>
    <lifeStages>
      <li><bodyGraphicData><texPath>Yunjianzi/Pawn/Shenji/ShenjiTransparentBody</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1</drawSize></bodyGraphicData></li>
    </lifeStages>
  </PawnKindDef>
  <PawnKindDef ParentName="YJZ_SkyWyvernKind_Base"><defName>YJZ_SkyWyvern_Purple</defName><label>云中灵麟</label><race>YJZ_SkyWyvern_Race_Purple</race><combatPower>1800</combatPower></PawnKindDef>
  <PawnKindDef ParentName="YJZ_SkyWyvernKind_Base">
    <defName>YJZ_SkyWyvern_Golden</defName><label>负霆瑞兽</label><race>YJZ_SkyWyvern_Race_Golden</race><combatPower>4500</combatPower>
    <abilities><li>YJZ_SkyWyvernBreath</li></abilities>
  </PawnKindDef>
  <PawnKindDef ParentName="YJZ_SkyWyvernKind_Base">
    <defName>YJZ_SkyWyvern_Spirit</defName><label>九天麟主</label><race>YJZ_SkyWyvern_Race_Spirit</race><combatPower>12000</combatPower>
    <abilities><li>YJZ_SkyWyvernBreath</li></abilities>
  </PawnKindDef>

  <!-- Animal_PreMain is an official extension point in the vanilla Animal
       think tree. The job giver immediately returns null for every other
       animal, so this does not alter colony pets or released war animals. -->
  <ThinkTreeDef>
    <defName>YJZ_SkyWyvernRaidAssault</defName>
    <insertTag>Animal_PreMain</insertTag>
    <insertPriority>1000</insertPriority>
    <thinkRoot Class="Yunjianzi.JobGiver_YunjianziSkyWyvernRaidAssault">
      <targetAcquireRadius>999</targetAcquireRadius>
      <targetKeepRadius>999</targetKeepRadius>
      <chaseTarget>true</chaseTarget>
      <allowTurrets>true</allowTurrets>
      <ignoreNonCombatants>true</ignoreNonCombatants>
    </thinkRoot>
  </ThinkTreeDef>

  <AbilityDef>
    <defName>YJZ_SkyWyvernBreath</defName>
    <label>九霄震息</label>
    <description>云麒麟将灵角间汇聚的雷光吐向敌人，冲击落点周围，使血肉麻痹、机械失去响应。</description>
    <iconPath>Yunjianzi/UI/Abilities/SummonSkyWyvern</iconPath>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <aiCanUse>true</aiCanUse>
    <ai_IsOffensive>true</ai_IsOffensive>
    <ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
    <hostile>true</hostile>
    <statBases><Ability_EffectRadius>3.9</Ability_EffectRadius></statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15.9</range>
      <warmupTime>1.2</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetHumans>true</canTargetHumans>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Yunjianzi.CompProperties_AbilitySkyWyvernBreath" />
    </comps>
  </AbilityDef>

  <HediffDef>
    <defName>YJZ_SkyWyvernAcceleration</defName>
    <label>祥光同庇</label>
    <description>云麒麟将瑞气散向同伴，帮助他们行动与出手。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages><li><statOffsets><MoveSpeed>0.6</MoveSpeed></statOffsets><capMods><li><capacity>Manipulation</capacity><offset>0.08</offset></li></capMods></li></stages>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks><min>120</min><max>120</max></disappearsAfterTicks></li></comps>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_QilinBattleRoar</defName>
    <label>麟威战吼</label>
    <description>战吼激起血脉之力，暂时加快云麒麟的移动与攻击。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.5</MoveSpeed>
          <MeleeCooldownFactor>0.6666667</MeleeCooldownFactor>
          <RangedCooldownFactor>0.6666667</RangedCooldownFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks><min>900</min><max>900</max></disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_SkyWyvernRegeneration</defName>
    <label>生生云息</label>
    <description>云麒麟持续恢复伤势，受损的经脉与残缺肢体也能够重新生长。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
  </HediffDef>
</Defs>
