<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="YJZ_SkyWyvern_Base" ParentName="AnimalThingBase" Abstract="True">
    <label>云麒麟</label>
    <description>前代曾在远行中照料过一头负伤幼麟。伤愈之后，她仍留在身边，陪他走过荒星与雷海。那段旧约也被记入手记，随传承留到今日。

新一代云间子循约相唤，她便再度同行。平日可伴人运物，临阵则踏雷迎敌，将瑞气分予近旁同伴。紫府显灵麟之形，金丹负霆，化神而九天真形渐全。

瑞兽凝身于云炁，伤重则散，待旧约再续时重来。不可取其肉皮，惟有吐纳凝露，自愿相赠。</description>
    <thingClass>Pawn</thingClass>
    <uiIconPath>Yunjianzi/UI/SkyWyvern</uiIconPath>
    <uiIconScale>1</uiIconScale>
    <statBases>
      <CarryingCapacity>3000</CarryingCapacity>
      <Wildness>0</Wildness>
      <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.0</ArmorRating_Blunt>
      <ArmorRating_Heat>1.2</ArmorRating_Heat>
      <!-- The cloud qilin neither creates animal filth nor tracks it indoors. -->
      <FilthRate>0</FilthRate>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
    </statBases>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <renderTree>Animal</renderTree>
      <intelligence>Animal</intelligence>
      <thinkTreeMain>Animal</thinkTreeMain>
      <thinkTreeConstant>AnimalConstant</thinkTreeConstant>
      <trainability>Advanced</trainability>
      <hasGenders>false</hasGenders>
      <canReleaseToWild>false</canReleaseToWild>
      <hasMeat>false</hasMeat>
      <hasCorpse>false</hasCorpse>
      <leatherDef IsNull="True" />
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <packAnimal>true</packAnimal>
      <!-- Match the vanilla thrumbo's maximum food consumption. A zero hunger
           rate also makes caravan food-day estimation hit an invalid edge case. -->
      <baseHungerRate>1.75</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <lifeExpectancy>9999</lifeExpectancy>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
      </specialTrainables>
      <lifeStageAges Inherit="False">
        <li><def>AnimalAdult</def><minAge>0</minAge><soundAngry>Pawn_Thrumbo_Angry</soundAngry></li>
      </lifeStageAges>
    </race>
    <comps>
      <li Class="Yunjianzi.CompProperties_QilinSaliva">
        <intervalDays>10</intervalDays>
        <amount>1</amount>
        <resourceDef>YJZ_QilinSaliva</resourceDef>
      </li>
    </comps>
    <tools>
      <li><label>青雷前爪</label><capacities><li>Scratch</li></capacities><power>30</power><cooldownTime>1.75</cooldownTime></li>
      <li><label>白玉颚</label><capacities><li>Bite</li></capacities><power>24</power><cooldownTime>2.1</cooldownTime></li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="YJZ_SkyWyvern_Base">
    <defName>YJZ_SkyWyvern_Race_Purple</defName>
    <label>云中灵麟</label>
    <statBases>
      <MoveSpeed>4.14</MoveSpeed><MaxHitPoints>6000</MaxHitPoints><MarketValue>24000</MarketValue>
    </statBases>
    <race><baseBodySize>4</baseBodySize><baseHealthScale>6</baseHealthScale></race>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziSkyWyvern">
        <stage>3</stage><groundTexPath>Yunjianzi/Pawn/SkyWyvern/UnifiedGround</groundTexPath><drawSize>1.8</drawSize>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="YJZ_SkyWyvern_Base">
    <defName>YJZ_SkyWyvern_Race_Golden</defName>
    <label>负霆瑞兽</label>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed><MaxHitPoints>30000</MaxHitPoints><MarketValue>65000</MarketValue>
      <ArmorRating_Sharp>2.0</ArmorRating_Sharp><ArmorRating_Blunt>1.5</ArmorRating_Blunt><ArmorRating_Heat>1.8</ArmorRating_Heat>
    </statBases>
    <race><baseBodySize>6</baseBodySize><baseHealthScale>9</baseHealthScale></race>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziSkyWyvern">
        <stage>4</stage><groundTexPath>Yunjianzi/Pawn/SkyWyvern/UnifiedGround</groundTexPath><drawSize>2.6</drawSize>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="YJZ_SkyWyvern_Base">
    <defName>YJZ_SkyWyvern_Race_Spirit</defName>
    <label>九天麟主</label>
    <statBases>
      <MoveSpeed>5.98</MoveSpeed><MaxHitPoints>500000</MaxHitPoints><MarketValue>250000</MarketValue>
      <ArmorRating_Sharp>2.8</ArmorRating_Sharp><ArmorRating_Blunt>2.2</ArmorRating_Blunt><ArmorRating_Heat>2.5</ArmorRating_Heat>
    </statBases>
    <race><baseBodySize>12</baseBodySize><baseHealthScale>18</baseHealthScale></race>
    <comps>
      <li Class="Yunjianzi.CompProperties_YunjianziSkyWyvern">
