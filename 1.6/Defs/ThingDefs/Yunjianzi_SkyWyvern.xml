    <defName>YJZ_SkyWyvern_Race_Golden</defName>
    <label>云麒麟·金丹</label>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed><MaxHitPoints>30000</MaxHitPoints><MarketValue>65000</MarketValue>
      <ArmorRating_Sharp>2.0</ArmorRating_Sharp><ArmorRating_Blunt>1.5</ArmorRating_Blunt><ArmorRating_Heat>1.8</ArmorRating_Heat>
    </statBases>
