<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="YJZ_SkyWyvern_Base" ParentName="AnimalThingBase" Abstract="True">
    <label>云麒麟</label>
    <description>栖于云海之上的古老生物灵兽，也是上一代云间子的坐骑。旧主远去后，她守着那份传承沉眠多年；当新一代云间子展开宝卷，她从相似却尚显稚嫩的气息中认出了道统，于是再度履行旧约，陪伴在传人身旁。她平日温顺而聪慧，能够搬运重物；袭击来临时则会自行解放，展开灵力护盾，以雷霆吐息与青雷利爪扑向敌群。</description>
    <thingClass>Pawn</thingClass>
    <statBases>
      <CarryingCapacity>3000</CarryingCapacity>
      <Wildness>0</Wildness>
      <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.0</ArmorRating_Blunt>
      <ArmorRating_Heat>1.2</ArmorRating_Heat>
    </statBases>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <renderTree>Animal</renderTree>
      <intelligence>Animal</intelligence>
      <thinkTreeMain>Animal</thinkTreeMain>
      <thinkTreeConstant>AnimalConstant</thinkTreeConstant>
      <trainability>Advanced</trainability>
      <hasGenders>false</hasGenders>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseHungerRate>0</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <lifeExpectancy>9999</lifeExpectancy>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
      </specialTrainables>
      <lifeStageAges Inherit="False">
        <li><def>AnimalAdult</def><minAge>0</minAge></li>
      </lifeStageAges>
    </race>
    <tools>
      <li><label>青雷前爪</label><capacities><li>Scratch</li></capacities><power>30</power><cooldownTime>1.75</cooldownTime></li>
      <li><label>白玉颚</label><capacities><li>Bite</li></capacities><power>24</power><cooldownTime>2.1</cooldownTime></li>
    </tools>
  </ThingDef>

