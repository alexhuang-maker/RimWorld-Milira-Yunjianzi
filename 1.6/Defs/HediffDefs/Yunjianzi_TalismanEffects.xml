<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef Name="YJZ_TalismanEffectBase" Abstract="True">
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
  </HediffDef>

  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Shenjie</defName><label>截真符·格物</label>
    <description>纷杂表象被符意层层削去，未知之中已有一线真意可循。</description>
    <stages><li><statOffsets><ResearchSpeed>1</ResearchSpeed></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Shenxing</defName><label>神行符·轻身</label>
    <description>轻灵之气行于足下，每一步都像云影越过山脊。</description>
    <stages><li><statOffsets><MoveSpeed>2</MoveSpeed></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Jiqing</defName><label>寄情符·澄怀</label>
    <description>山水草木之意寄于心间；所处之地越清雅，心神便越舒展。</description>
    <stages><li><statOffsets><SocialImpact>0.25</SocialImpact><MentalBreakThreshold>-0.10</MentalBreakThreshold></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Baicao</defName><label>百草符·通医</label>
    <description>百草医理映照病机，运针下刀皆能看清那一线生机。</description>
    <stages><li><statOffsets><MedicalTendQuality>0.50</MedicalTendQuality><MedicalSurgerySuccessChance>0.50</MedicalSurgerySuccessChance></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Xinjian</defName><label>心剑符·察心</label>
    <description>心剑斩去言语中的虚声，使迟疑、渴求与底线清晰可辨。</description>
    <stages><li><statOffsets><TradePriceImprovement>0.20</TradePriceImprovement><SocialImpact>0.10</SocialImpact></statOffsets></li></stages>
  </HediffDef>

  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Beidou</defName><label>斗转符·御器</label>
    <description>斗柄流转不息，持符者的出手、瞄准与御剑也随之更为迅捷。</description>
    <stages><li><statFactors><MeleeCooldownFactor>0.75</MeleeCooldownFactor><RangedCooldownFactor>0.75</RangedCooldownFactor><AimingDelayFactor>0.75</AimingDelayFactor></statFactors></li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Shenlian</defName><label>神炼符·御工</label>
    <description>器物尚未成形，神念已先见过它完成后的模样。</description>
    <stages><li><statOffsets><WorkSpeedGlobal>0.75</WorkSpeedGlobal></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Huijian</defName><label>慧剑斩念符·无扰</label>
    <description>一线慧剑横过灵台，外来低语与自生妄念至此而止。</description>
    <stages><li><statOffsets><PsychicSensitivity>-1</PsychicSensitivity><MentalBreakThreshold>-0.25</MentalBreakThreshold></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Bumei</defName><label>不昧真灵符·明心</label>
    <description>真灵历劫而不昧，所学所见皆能归入一颗澄明本心。</description>
    <stages><li><statOffsets><GlobalLearningFactor>1</GlobalLearningFactor><MentalBreakThreshold>-0.20</MentalBreakThreshold></statOffsets></li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Jiexin</defName><label>劫心符·淬体</label>
    <description>本源如火淬过筋骨，强盛由此而生，也由此带着一分劫意。</description>
    <stages><li>
      <statFactors><IncomingDamageFactor>0.80</IncomingDamageFactor></statFactors>
      <statOffsets><MoveSpeed>1</MoveSpeed><WorkSpeedGlobal>0.35</WorkSpeedGlobal><MeleeHitChance>4</MeleeHitChance><ShootingAccuracyPawn>4</ShootingAccuracyPawn><MedicalTendQuality>0.20</MedicalTendQuality></statOffsets>
      <capMods><li><capacity>Consciousness</capacity><offset>0.15</offset></li><li><capacity>Moving</capacity><offset>0.15</offset></li><li><capacity>Manipulation</capacity><offset>0.15</offset></li></capMods>
    </li></stages>
  </HediffDef>
  <HediffDef ParentName="YJZ_TalismanEffectBase">
    <defName>YJZ_TalismanEffect_Liuyang</defName><label>六阳真形符·躁阳</label>
    <description>六阳灌体，争斗之术臻于极境；阴阳失和，文思与心境也随之枯灼。</description>
    <stages><li><statOffsets><MeleeHitChance>6</MeleeHitChance><ShootingAccuracyPawn>6</ShootingAccuracyPawn><MentalBreakThreshold>0.25</MentalBreakThreshold></statOffsets></li></stages>
  </HediffDef>
</Defs>
