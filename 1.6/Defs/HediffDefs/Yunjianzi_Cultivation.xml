<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>YJZ_CultivationRealm</defName>
    <label>云间灵脉</label>
    <description>云间子将天空精灵科技与古修仙法相合后形成的灵脉。其严重度整数对应当前境界，并决定灵力上限与御剑诀阶段。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>5</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity><label>云间灵脉（练气）</label><becomeVisible>true</becomeVisible>
        <statOffsets><MoveSpeed>0.10</MoveSpeed></statOffsets>
        <statFactors><RestRateMultiplier>1.10</RestRateMultiplier></statFactors>
        <capMods>
          <li><capacity>Moving</capacity><offset>0.02</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.03</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>2</minSeverity><label>云间灵脉（筑基）</label><becomeVisible>true</becomeVisible>
        <statOffsets><MoveSpeed>0.20</MoveSpeed></statOffsets>
        <statFactors><RestRateMultiplier>1.20</RestRateMultiplier></statFactors>
        <capMods>
          <li><capacity>Moving</capacity><offset>0.04</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.06</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>3</minSeverity><label>云间灵脉（紫府）</label><becomeVisible>true</becomeVisible>
        <statOffsets><MoveSpeed>0.35</MoveSpeed></statOffsets>
        <statFactors><RestRateMultiplier>1.35</RestRateMultiplier></statFactors>
        <capMods>
          <li><capacity>Moving</capacity><offset>0.07</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.10</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>4</minSeverity><label>云间灵脉（金丹）</label><becomeVisible>true</becomeVisible>
        <statOffsets><MoveSpeed>0.55</MoveSpeed></statOffsets>
        <statFactors><RestRateMultiplier>1.60</RestRateMultiplier></statFactors>
        <capMods>
          <li><capacity>Moving</capacity><offset>0.11</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.15</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>5</minSeverity><label>云间灵脉（化神）</label><becomeVisible>true</becomeVisible>
        <statOffsets><MoveSpeed>0.85</MoveSpeed></statOffsets>
        <statFactors><RestRateMultiplier>2.00</RestRateMultiplier></statFactors>
        <capMods>
          <li><capacity>Moving</capacity><offset>0.16</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.22</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_SwordControlImmunity</defName>
    <label>剑意适应</label>
    <description>刚刚承受过诛邪的镇压，短时间内不会再次被同一附魔连续控制。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>300</disappearsAfterTicks></li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_SwordHeartClarity</defName>
    <label>剑心通明</label>
    <description>诛邪在手，剑心与本命剑相合，心神归一。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <becomeVisible>true</becomeVisible>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.05</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_ArrayShield</defName>
    <label>仙阵剑罡</label>
    <description>金丹境以上的仙阵为阵内友方人员与机械提供的弱型灵力护盾。离开阵法后会迅速消散。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>35</initialSeverity>
    <maxSeverity>35</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>120</disappearsAfterTicks></li>
    </comps>
    <stages><li><becomeVisible>true</becomeVisible></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_ArrayEdgeSlow</defName>
    <label>迟滞阵纹</label>
    <description>触碰仙阵边界后，周身气机被阵纹牵引，移动速度暂时降低。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks></li>
    </comps>
    <stages>
      <li>
        <becomeVisible>true</becomeVisible>
        <statFactors><MoveSpeed>0.60</MoveSpeed></statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_ArrayEdgeControlImmunity</defName>
    <label>阵纹适应</label>
    <description>刚刚触发过仙阵边界，短时间内不会再次受到同一边界控制。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800</disappearsAfterTicks></li>
    </comps>
    <stages><li><becomeVisible>false</becomeVisible></li></stages>
  </HediffDef>
</Defs>
