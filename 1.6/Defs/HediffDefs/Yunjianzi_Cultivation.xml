<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>YJZ_CultivationRealm</defName>
    <label>云间灵脉</label>
    <description>云间子将天空精灵科技与古修仙法相合后形成的灵脉。其严重度整数对应当前境界，并决定灵力上限与御剑诀阶段。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>5</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity><label>云间灵脉（练气）</label><becomeVisible>true</becomeVisible>
        <painFactor>0.95</painFactor><totalBleedFactor>0.95</totalBleedFactor>
        <statOffsets><MoveSpeed>0.15</MoveSpeed></statOffsets>
        <statFactors>
          <RestRateMultiplier>1.15</RestRateMultiplier>
          <InjuryHealingFactor>1.15</InjuryHealingFactor>
          <ImmunityGainSpeed>1.10</ImmunityGainSpeed>
          <IncomingDamageFactor>0.95</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.02</offset></li>
          <li><capacity>Moving</capacity><offset>0.05</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>2</minSeverity><label>云间灵脉（筑基）</label><becomeVisible>true</becomeVisible>
        <painFactor>0.85</painFactor><totalBleedFactor>0.85</totalBleedFactor>
        <statOffsets><MoveSpeed>0.35</MoveSpeed></statOffsets>
        <statFactors>
          <RestRateMultiplier>1.30</RestRateMultiplier>
          <InjuryHealingFactor>1.40</InjuryHealingFactor>
          <ImmunityGainSpeed>1.25</ImmunityGainSpeed>
          <IncomingDamageFactor>0.85</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.08</offset></li>
          <li><capacity>Moving</capacity><offset>0.12</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.15</offset></li>
          <li><capacity>Sight</capacity><offset>0.05</offset></li>
          <li><capacity>Hearing</capacity><offset>0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>3</minSeverity><label>云间灵脉（紫府）</label><becomeVisible>true</becomeVisible>
        <painFactor>0.60</painFactor><totalBleedFactor>0.60</totalBleedFactor>
        <statOffsets><MoveSpeed>1.25</MoveSpeed></statOffsets>
        <statFactors>
          <RestRateMultiplier>1.75</RestRateMultiplier>
          <InjuryHealingFactor>2.50</InjuryHealingFactor>
          <ImmunityGainSpeed>1.75</ImmunityGainSpeed>
          <IncomingDamageFactor>0.65</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.30</offset></li>
          <li><capacity>Moving</capacity><offset>0.45</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.55</offset></li>
          <li><capacity>Sight</capacity><offset>0.30</offset></li>
          <li><capacity>Hearing</capacity><offset>0.20</offset></li>
          <li><capacity>Breathing</capacity><offset>0.25</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>0.25</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.25</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.20</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>4</minSeverity><label>云间灵脉（金丹）</label><becomeVisible>true</becomeVisible>
        <painFactor>0.25</painFactor><totalBleedFactor>0.25</totalBleedFactor>
        <statOffsets><MoveSpeed>2.50</MoveSpeed></statOffsets>
        <statFactors>
          <RestRateMultiplier>2.50</RestRateMultiplier>
          <InjuryHealingFactor>5.00</InjuryHealingFactor>
          <ImmunityGainSpeed>2.75</ImmunityGainSpeed>
          <IncomingDamageFactor>0.35</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.60</offset></li>
          <li><capacity>Moving</capacity><offset>0.90</offset></li>
          <li><capacity>Manipulation</capacity><offset>1.00</offset></li>
          <li><capacity>Sight</capacity><offset>0.65</offset></li>
          <li><capacity>Hearing</capacity><offset>0.45</offset></li>
          <li><capacity>Breathing</capacity><offset>0.55</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>0.55</offset></li>
          <li><capacity>BloodPumping</capacity><offset>0.55</offset></li>
          <li><capacity>Metabolism</capacity><offset>0.45</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>5</minSeverity><label>云间灵脉（化神）</label><becomeVisible>true</becomeVisible>
        <painFactor>0.05</painFactor><totalBleedFactor>0.05</totalBleedFactor>
        <statOffsets><MoveSpeed>5.00</MoveSpeed></statOffsets>
        <statFactors>
          <RestRateMultiplier>5.00</RestRateMultiplier>
          <InjuryHealingFactor>12.00</InjuryHealingFactor>
          <ImmunityGainSpeed>5.00</ImmunityGainSpeed>
          <IncomingDamageFactor>0.10</IncomingDamageFactor>
        </statFactors>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>1.50</offset></li>
          <li><capacity>Moving</capacity><offset>2.00</offset></li>
          <li><capacity>Manipulation</capacity><offset>2.00</offset></li>
          <li><capacity>Sight</capacity><offset>1.50</offset></li>
          <li><capacity>Hearing</capacity><offset>1.00</offset></li>
          <li><capacity>Breathing</capacity><offset>1.50</offset></li>
          <li><capacity>BloodFiltration</capacity><offset>1.50</offset></li>
          <li><capacity>BloodPumping</capacity><offset>1.50</offset></li>
          <li><capacity>Metabolism</capacity><offset>1.25</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_SwordControlImmunity</defName>
    <label>剑意适应</label>
    <description>刚刚承受过诛邪的镇压，短时间内不会再次被同一附魔连续控制。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>300</disappearsAfterTicks></li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_SwordHeartClarity</defName>
    <label>剑心通明</label>
    <description>诛邪在手，剑心与本命剑相合，心神归一。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <becomeVisible>true</becomeVisible>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.05</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_ArrayShield</defName>
    <label>仙阵剑罡</label>
    <description>金丹境以上的仙阵为阵内友方人员与机械提供的弱型灵力护盾。离开阵法后会迅速消散。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>35</initialSeverity>
    <maxSeverity>35</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>120</disappearsAfterTicks></li>
    </comps>
    <stages><li><becomeVisible>true</becomeVisible></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_ArrayEdgeSlow</defName>
    <label>迟滞阵纹</label>
    <description>触碰仙阵边界后，周身气机被阵纹牵引，移动速度暂时降低。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>600</disappearsAfterTicks></li>
    </comps>
    <stages>
      <li>
        <becomeVisible>true</becomeVisible>
        <statFactors><MoveSpeed>0.60</MoveSpeed></statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>YJZ_ArrayEdgeControlImmunity</defName>
    <label>阵纹适应</label>
    <description>刚刚触发过仙阵边界，短时间内不会再次受到同一边界控制。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>1800</disappearsAfterTicks></li>
    </comps>
    <stages><li><becomeVisible>false</becomeVisible></li></stages>
  </HediffDef>
</Defs>
